<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-desktop</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Company>OpenSimTools</Company>
    <Authors>OpenSimTools Contributors</Authors>
    <AssemblyName>AMS2CM.GUI</AssemblyName>
    <RootNamespace>AMS2CM.GUI</RootNamespace>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishAot>false</PublishAot>
    <ApplicationIcon>..\Shared\AMS2CM.ico</ApplicationIcon>
    <UnoFeatures>Skia</UnoFeatures>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="GitVersion.MsBuild" Version="6.8.2">
      <PrivateAssets>All</PrivateAssets>
    </PackageReference>
    <ProjectReference Include="..\Core\Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="GUI.Tests" />
    <ApplicationDefinition Include="App.xaml" />
    <Content Include="..\Shared\Config.yaml" Link="Config.yaml" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\Shared\AMS2CM.ico" Link="AMS2CM.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
