<Configuration>
    <MappedFolders>
        <MappedFolder>
            <HostFolder></HostFolder>
            <SandboxFolder>C:\Installer</SandboxFolder>
        </MappedFolder>
    </MappedFolders>
    <LogonCommand>
        <Command>msiexec /i C:\Installer\AMS2CM.msi /L*V C:\Installer\install.log</Command>
    </LogonCommand>
</Configuration>
