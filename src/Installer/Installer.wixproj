<Project Sdk="WixToolset.Sdk/7.0.1">
  <PropertyGroup>
    <AcceptEula>wix7</AcceptEula>
    <OutputName>AMS2CM</OutputName>
    <UpdateAssemblyInfo>false</UpdateAssemblyInfo>
    <GenerateGitVersionInformation>false</GenerateGitVersionInformation>
    <GuiPublishDir>$(MSBuildProjectDirectory)\obj\$(Platform)\$(Configuration)\gui-publish\</GuiPublishDir>
    <DefineConstants>$(DefineConstants);GuiPublishDir=$(GuiPublishDir)</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="7.0.1" />
    <PackageReference Include="GitVersion.MsBuild" Version="6.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CLI\CLI.csproj" />
    <ProjectReference Include="..\GUI\GUI.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Sandbox.wsb" />
  </ItemGroup>
  <Target Name="SetUpSandbox" AfterTargets="Build">
    <!-- ItemGroup/Content seems to be ignored -->
    <Copy SourceFiles="Sandbox.wsb" DestinationFolder="$(TargetDir)" />
    <XmlPoke XmlInputPath="$(TargetDir)Sandbox.wsb" Value="$(TargetDir)" Query="/Configuration/MappedFolders/MappedFolder/HostFolder" />
  </Target>
  <Target Name="PublishGui" BeforeTargets="CoreCompile" DependsOnTargets="ResolveProjectReferences">
    <RemoveDir Directories="$(GuiPublishDir)" />
    <MSBuild Projects="..\GUI\GUI.csproj" Targets="Publish"
             Properties="Configuration=$(Configuration);Platform=$(Platform);RuntimeIdentifier=win-x64;PublishDir=$(GuiPublishDir)" />
  </Target>
</Project>
